# ---- Server ----
PORT=4200
NODE_ENV=development
LOG_LEVEL=debug
APP_NAME=mobile-repair-shop-backend
APP_URL=http://localhost:4200

# ---- Database (fresh, dedicated DB for the repair shop) ----
DB_NAME=mobile_repair_shop
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# ---- Auth ----
# CHANGE THIS in any real deployment.
LOGIN_JWT_SECRET=change-this-secret
LOGIN_JWT_EXPIRY=7d

# ---- Device unlock credential encryption ----
# Changing this makes existing stored credentials unreadable.
DEVICE_SECRET_KEY=change-this-device-secret-key

# ---- WhatsApp ----
# 'web': scan a QR code with your existing WhatsApp Business number, no Meta
#        app / business verification needed. Good to start with.
# 'cloud_api': Meta's official Cloud API — never Twilio/other providers.
#              Requires the fields below and an APPROVED template.
WHATSAPP_PROVIDER=web

# Get these from Meta Business Manager > WhatsApp > API Setup (only needed for cloud_api).
# WHATSAPP_ACCESS_TOKEN must NEVER be exposed to the frontend.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Must be an APPROVED template in Meta Business Manager before sending works.
WHATSAPP_RECEIPT_TEMPLATE_NAME=repair_receipt
WHATSAPP_TEMPLATE_LANGUAGE=en
# Prepended to a saved 10-digit mobile number that has no country code.
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Where the frontend is reachable from THIS server — a headless browser
# renders /repairs/:id/print here to build the receipt PDF sent on WhatsApp.
FRONTEND_URL=http://localhost:4000

# ---- CORS ----
CORS_ORIGIN=http://localhost:4000

# ---- Seed owner account (used once by the seeder) ----
OWNER_NAME=Shop Owner
OWNER_EMAIL=owner@sushantmobile.local
OWNER_PASSWORD=changeme123

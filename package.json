{
  "name": "mobile-repair-shop-backend",
  "version": "1.0.0",
  "description": "Mobile Repair Shop Management System — API",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "babel . -d dist --ignore \"node_modules/**\",\"dist/**\"",
    "dev": "nodemon --exec babel-node ./index.js",
    "start": "node ./dist/index",
    "db:create": "npx sequelize-cli db:create",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:migrate:generate": "npx sequelize-cli migration:generate --name",
    "db:seed:all": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed:all",
    "db:reset": "npx sequelize-cli db:drop && npm run db:setup",
    "lint": "eslint src index.js --ext .js",
    "lint:fix": "eslint src index.js --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" index.js",
    "format:check": "prettier --check \"src/**/*.js\" index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "bcrypt": "^6.0.0",
    "convict": "6.2.4",
    "cors": "2.8.5",
    "dayjs": "1.11.18",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "8.1.0",
    "http-status-codes": "2.3.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.5",
    "uuid": "^11.0.3",
    "whatsapp-web.js": "^1.34.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.0",
    "@babel/node": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-plugin-module-resolver": "5.0.2",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "sequelize-cli": "^6.6.2"
  }
}
